# Copy to .env.local and fill in. Both are optional: the site serves the curated
# data/photos.generated.json, and hides the Films section without a Pexels key.

# Unsplash → https://unsplash.com/oauth/applications → "New Application" → Access Key
UNSPLASH_ACCESS_KEY=

# Re-curate on the server every 24h instead of serving data/photos.generated.json.
# Needs a production-tier key (a full pass is ~70 requests; demo keys allow 50/hour).
UNSPLASH_LIVE_REFRESH=false

# Pexels → https://www.pexels.com/api/ → "Your API Key"
PEXELS_API_KEY=
